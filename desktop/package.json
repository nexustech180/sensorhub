{
  "name": "gold-var-sensor-hub-desktop",
  "productName": "Gold Var Sensor Hub",
  "version": "0.2.0",
  "private": true,
  "description": "Gold Var Sensor Hub for Windows",
  "author": "GOLD-VAR team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.goldvar.sensorhub",
    "productName": "Gold Var Sensor Hub",
    "files": ["main.js", "www/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "target": "portable",
      "artifactName": "GoldVarSensorHub-64bit.exe"
    }
  }
}

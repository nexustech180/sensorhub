{
  "name": "gold-var-sensor-hub-desktop",
  "productName": "Gold Var Sensor Hub",
  "version": "0.3.2",
  "private": true,
  "description": "Gold Var Sensor Hub for Windows and macOS",
  "author": "GOLD-VAR team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.goldvar.sensorhub",
    "productName": "Gold Var Sensor Hub",
    "files": [
      "main.js",
      "www/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "artifactName": "GoldVarSensorHub-64bit.exe"
    },
    "protocols": [
      {
        "name": "Gold Var Sensor Hub",
        "schemes": [
          "goldvar"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "GoldVarSensorHub-mac.dmg",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "Gold Var Sensor Hub"
    }
  }
}
